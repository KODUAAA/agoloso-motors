# Copy this file to .env and fill in the values. Never commit .env.

# Supabase: Project Settings -> Database -> Connection string -> "Session pooler"
DATABASE_URL=postgresql://postgres.YOUR_PROJECT_REF:YOUR_PASSWORD@aws-0-YOUR_REGION.pooler.supabase.com:5432/postgres
# Set to false only for a local Postgres without SSL
DATABASE_SSL=true
# Supabase's CA certificate, so the server can verify it is really talking to Supabase.
# Download it from Project Settings -> Database -> SSL Configuration, save it in this
# folder as prod-ca-2021.crt (it is git-ignored), and set the path here.
# On a host like Render, paste the certificate's text as the value instead.
DATABASE_CA_CERT=./prod-ca-2021.crt

# Long random string used to sign login tokens. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=
JWT_EXPIRES_IN=8h

PORT=5000
# Comma-separated list of sites allowed to call the API from another domain.
# Leave empty when the frontend is served by this same server (the default setup).
CORS_ORIGINS=

# Used once by `npm run seed` to create the first admin account
ADMIN_NAME=Admin
ADMIN_EMAIL=admin@lamontmotors.com
ADMIN_PASSWORD=

DEALERSHIP_NAME=Lamont Motors
# Any ISO currency code, e.g. USD, GHS, GBP, EUR, NGN
CURRENCY=USD
# km or mi
DISTANCE_UNIT=km
# Finance rate (APR %) used by the calculator and finance applications
DEFAULT_APR=9.9
